<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://openbox.org/3.4/menu">

  <!-- ═══ Desktop Right-Click Menu ═══════════════════════════════════ -->
  <menu id="root-menu" label="SleekOS">

    <item label="Web Browser">
      <action name="Execute"><command>firefox-esr</command></action>
    </item>
    <item label="File Manager">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><command>sakura</command></action>
    </item>
    <item label="SleekAI Assistant">
      <action name="Execute"><command>/usr/local/bin/sleek-ai</command></action>
    </item>

    <separator/>

    <menu id="apps-menu" label="Applications">
      <item label="Text Editor">
        <action name="Execute"><command>mousepad</command></action>
      </item>
      <item label="Media Player">
        <action name="Execute"><command>vlc</command></action>
      </item>
      <item label="Image Viewer">
        <action name="Execute"><command>eog</command></action>
      </item>
      <item label="PDF Viewer">
        <action name="Execute"><command>evince</command></action>
      </item>
      <item label="Disk Usage">
        <action name="Execute"><command>baobab</command></action>
      </item>
      <item label="Disks">
        <action name="Execute"><command>gnome-disks</command></action>
      </item>
      <item label="System Monitor">
        <action name="Execute"><command>sakura -e htop</command></action>
      </item>
    </menu>

    <menu id="settings-menu" label="Settings">
      <item label="Appearance">
        <action name="Execute"><command>lxappearance</command></action>
      </item>
      <item label="Window Manager">
        <action name="Execute"><command>obconf</command></action>
      </item>
      <item label="Display">
        <action name="Execute"><command>xrandr --auto</command></action>
      </item>
      <item label="Wallpaper">
        <action name="Execute"><command>nitrogen</command></action>
      </item>
      <item label="Network">
        <action name="Execute"><command>nm-connection-editor</command></action>
      </item>
      <item label="Power">
        <action name="Execute"><command>xfce4-power-manager-settings</command></action>
      </item>
    </menu>

    <separator/>

    <item label="Set Wallpaper">
      <action name="Execute"><command>nitrogen</command></action>
    </item>

    <menu id="about-menu" label="About SleekOS">
      <item label="System Info">
        <action name="Execute"><command>sakura -e bash -c 'neofetch; read -p "Press Enter..."'</command></action>
      </item>
      <item label="About">
        <action name="Execute"><command>/usr/local/bin/sleekos-about</command></action>
      </item>
    </menu>

    <separator/>

    <item label="Lock Screen">
      <action name="Execute"><command>dm-tool lock</command></action>
    </item>
    <item label="Log Out">
      <action name="Execute"><command>openbox --exit</command></action>
    </item>
    <item label="Reboot">
      <action name="Execute"><command>systemctl reboot</command></action>
    </item>
    <item label="Shutdown">
      <action name="Execute"><command>systemctl poweroff</command></action>
    </item>

  </menu>

</openbox_menu>
