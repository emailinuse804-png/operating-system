/*
 * SleekOS Rofi Theme
 * Windows 11-inspired Start Menu / App Launcher
 */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Windows";
    drun-display-format: "{name}";
    font:                "Noto Sans 12";
}

* {
    bg:           #1e1e2e;
    bg-alt:       #181825;
    bg-selected:  #313244;
    fg:           #cdd6f4;
    fg-alt:       #585b70;
    accent:       #89b4fa;
    urgent:       #f38ba8;
    border-col:   #45475a;
    transparent:  #00000000;

    background-color: @transparent;
    text-color:       @fg;
    border-color:     @border-col;
}

window {
    width:            680px;
    height:           520px;
    location:         center;
    anchor:           center;
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    16px;
    padding:          0;
    cursor:           "default";
}

mainbox {
    background-color: @transparent;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @bg-alt;
    children:         [ textbox-prompt-colon, entry ];
    padding:          14px 20px;
    border:           0 0 1px 0;
    border-color:     @border-col;
    border-radius:    16px 16px 0 0;
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              "🔍";
    padding:          0 12px 0 0;
    font:             "Noto Sans 14";
}

entry {
    background-color: @transparent;
    text-color:       @fg;
    cursor:           text;
    placeholder:      "Search apps, files, and settings...";
    placeholder-color: @fg-alt;
    font:             "Noto Sans 13";
}

listview {
    background-color: @transparent;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        true;
    layout:           vertical;
    padding:          8px;
    spacing:          2px;
    fixed-height:     true;
    fixed-columns:    true;
}

scrollbar {
    handle-width:     4px;
    handle-color:     @fg-alt;
    border-radius:    99px;
    background-color: @transparent;
}

element {
    background-color: @transparent;
    orientation:      horizontal;
    border-radius:    10px;
    padding:          10px 16px;
    spacing:          12px;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element-icon {
    background-color: @transparent;
    size:             32px;
    cursor:           inherit;
}

element-text {
    background-color: @transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    background-color: @bg-alt;
    padding:          12px 20px;
    border-radius:    0 0 16px 16px;
}

textbox {
    background-color: @transparent;
    text-color:       @fg;
}

error-message {
    background-color: @bg;
    border-radius:    16px;
    padding:          20px;
}
