#!/usr/bin/env python3
"""
SleekOS Welcome Screen
Displays on first boot with quick-start tips.
"""

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Pango
import subprocess
import os

class WelcomeWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to SleekOS")
        self.set_default_size(700, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)

        # Dark theme
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)

        # Header
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Welcome to SleekOS")
        self.set_titlebar(header)

        # Main container
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main)

        # Hero section
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        hero.set_margin_top(32)
        hero.set_margin_bottom(24)
        hero.set_margin_start(48)
        hero.set_margin_end(48)

        title = Gtk.Label()
        title.set_markup(
            '<span size="xx-large" foreground="#89b4fa"><b>Welcome to SleekOS</b></span>'
        )
        hero.pack_start(title, False, False, 0)

        subtitle = Gtk.Label()
        subtitle.set_markup(
            '<span foreground="#a6adc8">Your modern, AI-powered desktop is ready</span>'
        )
        hero.pack_start(subtitle, False, False, 0)

        main.pack_start(hero, False, False, 0)

        # Separator
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        main.pack_start(sep, False, False, 0)

        # Quick actions grid
        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(12)
        grid.set_margin_top(24)
        grid.set_margin_bottom(24)
        grid.set_margin_start(48)
        grid.set_margin_end(48)

        actions = [
            ("🌐", "Browse the Web", "Open Firefox", ["firefox-esr"]),
            ("🧠", "AI Assistant", "Chat with SleekAI", ["/usr/local/bin/sleek-ai"]),
            ("📁", "File Manager", "Browse your files", ["pcmanfm"]),
            ("💻", "Terminal", "Open command line", ["sakura"]),
            ("⚙️", "Settings", "Customize SleekOS", ["/usr/local/bin/sleekos-settings"]),
            ("📦", "Setup AI Models", "Install Ollama models", ["sakura", "-e", "ollama-models"]),
        ]

        for i, (icon, title, desc, cmd) in enumerate(actions):
            row = i // 2
            col = i % 2

            btn = Gtk.Button()
            btn.set_relief(Gtk.ReliefStyle.NONE)

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_top(8)
            box.set_margin_bottom(8)
            box.set_margin_start(12)
            box.set_margin_end(12)

            icon_lbl = Gtk.Label(label=icon)
            icon_lbl.set_size_request(32, -1)
            box.pack_start(icon_lbl, False, False, 0)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            title_lbl = Gtk.Label()
            title_lbl.set_markup(f"<b>{title}</b>")
            title_lbl.set_halign(Gtk.Align.START)
            text_box.pack_start(title_lbl, False, False, 0)

            desc_lbl = Gtk.Label(label=desc)
            desc_lbl.set_halign(Gtk.Align.START)
            desc_lbl.get_style_context().add_class("dim-label")
            text_box.pack_start(desc_lbl, False, False, 0)

            box.pack_start(text_box, True, True, 0)
            btn.add(box)
            btn.connect("clicked", lambda w, c=cmd: subprocess.Popen(c))

            grid.attach(btn, col, row, 1, 1)

        main.pack_start(grid, True, True, 0)

        # Footer
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        footer.set_margin_bottom(16)
        footer.set_margin_start(48)
        footer.set_margin_end(48)

        show_check = Gtk.CheckButton(label="Show this window on startup")
        show_check.set_active(True)
        footer.pack_start(show_check, True, True, 0)

        close_btn = Gtk.Button(label="Get Started")
        close_btn.get_style_context().add_class("suggested-action")
        close_btn.connect("clicked", lambda w: self.close())
        footer.pack_end(close_btn, False, False, 0)

        main.pack_end(footer, False, False, 0)


def main():
    win = WelcomeWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
