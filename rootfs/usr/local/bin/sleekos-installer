#!/bin/bash
###############################################################################
# SleekOS Installer
# Install SleekOS to a physical or virtual disk
###############################################################################

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

clear
echo -e "${BLUE}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                                                              ║"
echo "║              SleekOS v1.0 Installer                          ║"
echo "║              Aurora Edition                                  ║"
echo "║                                                              ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"
echo ""

# Check root
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}Error: This installer must be run as root (use sudo)${NC}"
    exit 1
fi

# List available disks
echo -e "${CYAN}Available disks:${NC}"
echo ""
lsblk -d -o NAME,SIZE,TYPE,MODEL | grep -E "disk"
echo ""

# Select target disk
read -p "Enter target disk (e.g., sda): " TARGET_DISK
TARGET="/dev/${TARGET_DISK}"

if [[ ! -b "$TARGET" ]]; then
    echo -e "${RED}Error: ${TARGET} is not a valid block device${NC}"
    exit 1
fi

echo ""
echo -e "${YELLOW}WARNING: This will ERASE ALL DATA on ${TARGET}!${NC}"
read -p "Type 'YES' to continue: " CONFIRM
if [[ "$CONFIRM" != "YES" ]]; then
    echo "Installation cancelled."
    exit 0
fi

echo ""
echo -e "${CYAN}Step 1/6: Partitioning disk...${NC}"

# Create partitions
parted -s "$TARGET" mklabel gpt
parted -s "$TARGET" mkpart ESP fat32 1MiB 512MiB
parted -s "$TARGET" set 1 esp on
parted -s "$TARGET" mkpart primary ext4 512MiB 100%

# Wait for kernel to update partition table
sleep 2
partprobe "$TARGET"
sleep 1

# Determine partition names
if [[ "$TARGET" == *"nvme"* ]] || [[ "$TARGET" == *"loop"* ]]; then
    PART1="${TARGET}p1"
    PART2="${TARGET}p2"
else
    PART1="${TARGET}1"
    PART2="${TARGET}2"
fi

echo -e "${CYAN}Step 2/6: Formatting partitions...${NC}"
mkfs.fat -F32 "$PART1"
mkfs.ext4 -F "$PART2"

echo -e "${CYAN}Step 3/6: Mounting partitions...${NC}"
MOUNT_DIR="/mnt/sleekos-install"
mkdir -p "$MOUNT_DIR"
mount "$PART2" "$MOUNT_DIR"
mkdir -p "$MOUNT_DIR/boot/efi"
mount "$PART1" "$MOUNT_DIR/boot/efi"

echo -e "${CYAN}Step 4/6: Copying system files...${NC}"
echo "  This may take several minutes..."

# Copy the live filesystem
rsync -aAXv / "$MOUNT_DIR" \
    --exclude=/proc \
    --exclude=/sys \
    --exclude=/dev \
    --exclude=/run \
    --exclude=/tmp \
    --exclude=/mnt \
    --exclude=/media \
    --exclude=/lost+found \
    --exclude=/live \
    --exclude=/cdrom \
    --progress 2>&1 | tail -1

# Create missing directories
mkdir -p "$MOUNT_DIR"/{proc,sys,dev,run,tmp,mnt,media}

echo -e "${CYAN}Step 5/6: Configuring bootloader...${NC}"

# Mount virtual filesystems
mount --bind /dev     "$MOUNT_DIR/dev"
mount --bind /dev/pts "$MOUNT_DIR/dev/pts"
mount -t proc proc    "$MOUNT_DIR/proc"
mount -t sysfs sysfs  "$MOUNT_DIR/sys"

# Generate fstab
ROOT_UUID=$(blkid -o value -s UUID "$PART2")
EFI_UUID=$(blkid -o value -s UUID "$PART1")
cat > "$MOUNT_DIR/etc/fstab" << FSTAB
# SleekOS fstab - Generated by installer
UUID=${ROOT_UUID}  /          ext4  errors=remount-ro  0 1
UUID=${EFI_UUID}   /boot/efi  vfat  umask=0077         0 1
tmpfs              /tmp       tmpfs defaults,noatime   0 0
FSTAB

# Install GRUB
chroot "$MOUNT_DIR" bash -c "
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=SleekOS --recheck 2>/dev/null || true
    grub-install --target=i386-pc ${TARGET} 2>/dev/null || true
    update-grub
"

echo -e "${CYAN}Step 6/6: Cleaning up...${NC}"

# Remove live-boot packages
chroot "$MOUNT_DIR" bash -c "
    apt-get remove -y live-boot live-config live-config-systemd 2>/dev/null || true
    apt-get autoremove -y 2>/dev/null || true
"

# Disable autologin for installed system
sed -i 's/autologin-user=sleek/#autologin-user=sleek/' "$MOUNT_DIR/etc/lightdm/lightdm.conf"

# Unmount everything
umount -lf "$MOUNT_DIR/proc" 2>/dev/null || true
umount -lf "$MOUNT_DIR/sys" 2>/dev/null || true
umount -lf "$MOUNT_DIR/dev/pts" 2>/dev/null || true
umount -lf "$MOUNT_DIR/dev" 2>/dev/null || true
umount -lf "$MOUNT_DIR/boot/efi" 2>/dev/null || true
umount -lf "$MOUNT_DIR" 2>/dev/null || true

echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║                                                              ║${NC}"
echo -e "${GREEN}║              Installation Complete!                          ║${NC}"
echo -e "${GREEN}║                                                              ║${NC}"
echo -e "${GREEN}║  Remove the installation media and reboot.                   ║${NC}"
echo -e "${GREEN}║                                                              ║${NC}"
echo -e "${GREEN}║  Default credentials:                                        ║${NC}"
echo -e "${GREEN}║    User: sleek  |  Password: sleekos                         ║${NC}"
echo -e "${GREEN}║                                                              ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
read -p "Press Enter to reboot (or Ctrl+C to stay)..." _
reboot
