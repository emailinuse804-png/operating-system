#!/usr/bin/env python3
"""SleekOS About Dialog"""

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GdkPixbuf
import platform

def main():
    settings = Gtk.Settings.get_default()
    settings.set_property("gtk-application-prefer-dark-theme", True)

    dialog = Gtk.AboutDialog()
    dialog.set_program_name("SleekOS")
    dialog.set_version("1.0 Aurora")
    dialog.set_comments(
        "A modern, sleek operating system with Windows-inspired UI,\n"
        "Ollama AI integration, and full browser support.\n\n"
        f"Kernel: {platform.release()}\n"
        f"Architecture: {platform.machine()}"
    )
    dialog.set_website("https://sleekos.dev")
    dialog.set_website_label("SleekOS Website")
    dialog.set_authors(["SleekOS Team"])
    dialog.set_license_type(Gtk.License.MIT_X11)
    dialog.set_copyright("Copyright 2025 SleekOS")
    dialog.set_logo_icon_name("applications-system")

    dialog.run()
    dialog.destroy()

if __name__ == "__main__":
    main()
