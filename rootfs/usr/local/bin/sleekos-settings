#!/usr/bin/env python3
"""
SleekOS Settings - System Configuration GUI
A modern settings panel inspired by Windows 11.
"""

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Gio
import subprocess
import os

class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Settings")
        self.set_default_size(900, 650)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Dark theme
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)

        # Header bar
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Settings")
        self.set_titlebar(header)

        # Main layout
        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(main_box)

        # Sidebar
        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_size_request(220, -1)
        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.sidebar = Gtk.ListBox()
        self.sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.sidebar.connect("row-selected", self.on_category_selected)
        sidebar_scroll.add(self.sidebar)

        sidebar_frame = Gtk.Frame()
        sidebar_frame.add(sidebar_scroll)
        main_box.pack_start(sidebar_frame, False, False, 0)

        # Content area
        self.content_scroll = Gtk.ScrolledWindow()
        self.content_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main_box.pack_start(self.content_scroll, True, True, 0)

        # Add categories
        categories = [
            ("🖥️", "Display", self.create_display_page),
            ("🎨", "Appearance", self.create_appearance_page),
            ("🌐", "Network", self.create_network_page),
            ("🔊", "Sound", self.create_sound_page),
            ("🧠", "AI Assistant", self.create_ai_page),
            ("⚡", "Power", self.create_power_page),
            ("ℹ️", "About", self.create_about_page),
        ]

        self.pages = {}
        for icon, name, creator in categories:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_top(8)
            box.set_margin_bottom(8)
            box.set_margin_start(16)
            box.set_margin_end(16)

            icon_label = Gtk.Label(label=icon)
            icon_label.set_size_request(24, -1)
            box.pack_start(icon_label, False, False, 0)

            name_label = Gtk.Label(label=name)
            name_label.set_halign(Gtk.Align.START)
            box.pack_start(name_label, True, True, 0)

            row.add(box)
            row.name = name
            self.sidebar.add(row)
            self.pages[name] = creator

        # Select first row
        self.sidebar.select_row(self.sidebar.get_row_at_index(0))

    def on_category_selected(self, listbox, row):
        if row is None:
            return
        # Clear content
        child = self.content_scroll.get_child()
        if child:
            self.content_scroll.remove(child)
        # Create new page
        page = self.pages[row.name]()
        self.content_scroll.add(page)
        self.content_scroll.show_all()

    def create_section(self, title, description=""):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(16)
        box.set_margin_start(24)

        label = Gtk.Label()
        label.set_markup(f"<b>{title}</b>")
        label.set_halign(Gtk.Align.START)
        box.pack_start(label, False, False, 0)

        if description:
            desc = Gtk.Label(label=description)
            desc.set_halign(Gtk.Align.START)
            desc.get_style_context().add_class("dim-label")
            box.pack_start(desc, False, False, 0)

        return box

    def create_setting_row(self, label_text, widget):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_margin_start(24)
        row.set_margin_end(24)
        row.set_margin_top(8)
        row.set_margin_bottom(8)

        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        row.pack_start(label, True, True, 0)
        row.pack_end(widget, False, False, 0)

        return row

    def create_display_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)
        page.set_margin_bottom(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>Display</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        # Resolution
        section = self.create_section("Resolution")
        page.pack_start(section, False, False, 0)

        res_combo = Gtk.ComboBoxText()
        for res in ["1920x1080", "1280x720", "1366x768", "2560x1440", "3840x2160"]:
            res_combo.append_text(res)
        res_combo.set_active(0)
        row = self.create_setting_row("Screen Resolution", res_combo)
        page.pack_start(row, False, False, 0)

        # Apply button
        apply_btn = Gtk.Button(label="Apply Resolution")
        apply_btn.set_margin_start(24)
        apply_btn.set_margin_end(24)
        apply_btn.set_margin_top(8)
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", lambda w: subprocess.run(
            ["xrandr", "--output", "Virtual1", "--mode", res_combo.get_active_text()],
            capture_output=True
        ))
        page.pack_start(apply_btn, False, False, 0)

        return page

    def create_appearance_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)
        page.set_margin_bottom(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>Appearance</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        # Theme
        section = self.create_section("Theme")
        page.pack_start(section, False, False, 0)

        theme_btn = Gtk.Button(label="Open Appearance Settings")
        theme_btn.set_margin_start(24)
        theme_btn.set_margin_end(24)
        theme_btn.connect("clicked", lambda w: subprocess.Popen(["lxappearance"]))
        page.pack_start(theme_btn, False, False, 0)

        # Wallpaper
        section = self.create_section("Wallpaper", "Change your desktop background")
        page.pack_start(section, False, False, 0)

        wall_btn = Gtk.Button(label="Change Wallpaper")
        wall_btn.set_margin_start(24)
        wall_btn.set_margin_end(24)
        wall_btn.connect("clicked", lambda w: subprocess.Popen(["nitrogen"]))
        page.pack_start(wall_btn, False, False, 0)

        return page

    def create_network_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>Network</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        net_btn = Gtk.Button(label="Open Network Manager")
        net_btn.set_margin_start(24)
        net_btn.set_margin_end(24)
        net_btn.set_margin_top(16)
        net_btn.connect("clicked", lambda w: subprocess.Popen(["nm-connection-editor"]))
        page.pack_start(net_btn, False, False, 0)

        return page

    def create_sound_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>Sound</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        # Volume
        section = self.create_section("Volume")
        page.pack_start(section, False, False, 0)

        vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        vol_scale.set_value(75)
        vol_scale.set_margin_start(24)
        vol_scale.set_margin_end(24)
        vol_scale.connect("value-changed", lambda w: subprocess.run(
            ["amixer", "sset", "Master", f"{int(w.get_value())}%"],
            capture_output=True
        ))
        page.pack_start(vol_scale, False, False, 0)

        return page

    def create_ai_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>AI Assistant</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        section = self.create_section("Ollama", "Manage your local AI models")
        page.pack_start(section, False, False, 0)

        # Status
        try:
            import urllib.request
            urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
            status_text = "✅ Ollama is running"
        except:
            status_text = "❌ Ollama is not running"

        status = Gtk.Label(label=status_text)
        status.set_halign(Gtk.Align.START)
        status.set_margin_start(24)
        status.set_margin_top(8)
        page.pack_start(status, False, False, 0)

        # Buttons
        start_btn = Gtk.Button(label="Start Ollama Service")
        start_btn.set_margin_start(24)
        start_btn.set_margin_end(24)
        start_btn.set_margin_top(8)
        start_btn.connect("clicked", lambda w: subprocess.Popen(
            ["sudo", "systemctl", "start", "ollama"]
        ))
        page.pack_start(start_btn, False, False, 0)

        models_btn = Gtk.Button(label="Manage Models")
        models_btn.set_margin_start(24)
        models_btn.set_margin_end(24)
        models_btn.set_margin_top(4)
        models_btn.connect("clicked", lambda w: subprocess.Popen(
            ["sakura", "-e", "ollama-models"]
        ))
        page.pack_start(models_btn, False, False, 0)

        chat_btn = Gtk.Button(label="Open SleekAI Chat")
        chat_btn.set_margin_start(24)
        chat_btn.set_margin_end(24)
        chat_btn.set_margin_top(4)
        chat_btn.get_style_context().add_class("suggested-action")
        chat_btn.connect("clicked", lambda w: subprocess.Popen(["/usr/local/bin/sleek-ai"]))
        page.pack_start(chat_btn, False, False, 0)

        return page

    def create_power_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        page.set_margin_top(24)

        title = Gtk.Label()
        title.set_markup("<span size='x-large'><b>Power</b></span>")
        title.set_halign(Gtk.Align.START)
        title.set_margin_start(24)
        page.pack_start(title, False, False, 0)

        for label, cmd in [
            ("Power Manager Settings", ["xfce4-power-manager-settings"]),
            ("Lock Screen", ["dm-tool", "lock"]),
            ("Reboot", ["systemctl", "reboot"]),
            ("Shutdown", ["systemctl", "poweroff"]),
        ]:
            btn = Gtk.Button(label=label)
            btn.set_margin_start(24)
            btn.set_margin_end(24)
            btn.set_margin_top(8)
            btn.connect("clicked", lambda w, c=cmd: subprocess.Popen(c))
            if "Shutdown" in label:
                btn.get_style_context().add_class("destructive-action")
            page.pack_start(btn, False, False, 0)

        return page

    def create_about_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        page.set_margin_top(48)
        page.set_margin_start(24)
        page.set_margin_end(24)

        # Logo area
        logo = Gtk.Label()
        logo.set_markup(
            "<span size='xx-large' foreground='#89b4fa'><b>SleekOS</b></span>\n"
            "<span size='large'>Aurora Edition</span>"
        )
        logo.set_justify(Gtk.Justification.CENTER)
        page.pack_start(logo, False, False, 0)

        version = Gtk.Label()
        version.set_markup(
            "\n<span foreground='#a6adc8'>Version 1.0</span>\n"
            "<span foreground='#585b70'>Built on Debian GNU/Linux</span>\n"
            "<span foreground='#585b70'>x86_64 Architecture</span>\n"
        )
        version.set_justify(Gtk.Justification.CENTER)
        page.pack_start(version, False, False, 0)

        # System info
        try:
            import platform
            info = (
                f"Kernel: {platform.release()}\n"
                f"Python: {platform.python_version()}\n"
                f"Architecture: {platform.machine()}"
            )
        except:
            info = "System info unavailable"

        info_label = Gtk.Label(label=info)
        info_label.set_justify(Gtk.Justification.CENTER)
        info_label.get_style_context().add_class("dim-label")
        info_label.set_margin_top(16)
        page.pack_start(info_label, False, False, 0)

        return page


def main():
    win = SettingsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
