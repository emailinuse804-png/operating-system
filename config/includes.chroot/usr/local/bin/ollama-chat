#!/usr/bin/env bash
set -euo pipefail

MODEL="${OLLAMA_DEFAULT_MODEL:-llama3.2}"

if ! command -v ollama >/dev/null 2>&1; then
  echo "Ollama is not installed yet."
  echo "Connect to the internet and wait for sleek-ollama-bootstrap.service to complete."
  exit 1
fi

if ! pgrep -x ollama >/dev/null 2>&1; then
  nohup ollama serve >/tmp/ollama-serve.log 2>&1 &
  sleep 2
fi

exec xfce4-terminal --title="Ollama Chat" --command "bash -lc 'ollama run ${MODEL} || exec bash'"
